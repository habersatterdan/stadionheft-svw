{% extends "_basis.html.j2" %}

{% block koerper %}
<div class="seite trenner">
  <div class="gruppe">{{ daten.gruppe or daten.anzeigename }}</div>
  {% if daten.untertitel %}
    <div class="untertitel">{{ daten.untertitel }}</div>
  {% endif %}
  {% if daten.pokalspiel %}
    <div class="liga">{{ daten.naechstes_spiel.wettbewerb }}
      {%- if daten.naechstes_spiel.spieltag %} &middot; {{ daten.naechstes_spiel.spieltag }}{% endif %}</div>
  {% elif daten.liga %}
    <div class="liga">{{ daten.liga }}</div>
  {% endif %}
</div>
{% endblock %}
