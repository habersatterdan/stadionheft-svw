{% extends "_inhaltsseite.html.j2" %}
{% import "_makros.html.j2" as m %}

{% block inhalt %}
  {% if eintraege %}
    <div class="kontakte ansprechpartner">
      {% for e in eintraege %}
        <div class="eintrag">
          <span class="rolle">{{ e.funktion }}:</span> {{ e.name }}<br>
          <span class="kontaktdaten">{{ e.kontakt }}</span>
        </div>
      {% endfor %}
    </div>
  {% else %}
    {{ m.leer("Keine Ansprechpartner hinterlegt (config.yaml, Abschnitt deckblatt.ansprechpartner).") }}
  {% endif %}
{% endblock %}
