{% extends "_inhaltsseite.html.j2" %}
{% import "_makros.html.j2" as m %}

{% block inhalt %}
  {% if abschnitte %}
    <div class="kontakte">
      {% for abschnitt in abschnitte %}
        <h2>{{ abschnitt.titel }}</h2>
        {% for eintrag in abschnitt.eintraege %}
          <div class="eintrag">
            <span class="rolle">{{ eintrag.rolle }}:</span> {{ eintrag.name }}<br>
            <span class="kontaktdaten">
              {%- if eintrag.telefon %}{{ eintrag.telefon }}{% endif %}
              {%- if eintrag.telefon and eintrag.email %} &bull; {% endif %}
              {%- if eintrag.email %}{{ eintrag.email }}{% endif %}
            </span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  {% else %}
    {{ m.leer("Keine Kontaktdaten hinterlegt. Datei config/kontakte.yaml anlegen.") }}
  {% endif %}
{% endblock %}
