{% extends "_inhaltsseite.html.j2" %}
{% import "_makros.html.j2" as m %}

{% block inhalt %}
  {% set spiel = daten.naechstes_spiel %}

  {% if spiel %}
    <div class="spielkarte">
      <div class="paarung">{{ spiel.paarung }}</div>
      <dl>
        <dt>Wettbewerb</dt><dd>{{ spiel.wettbewerb or '—' }}</dd>
        <dt>Datum</dt><dd>{{ spiel.wochentag }}, {{ spiel.datum or '—' }}</dd>
        <dt>Anstoß</dt><dd>{{ spiel.uhrzeit or '—' }}</dd>
        <dt>Heim/Auswärts</dt><dd>{{ 'Heimspiel' if spiel.heimspiel else 'Auswärtsspiel' }}</dd>
        <dt>Spielort</dt><dd>{{ spiel.spielort or '—' }}</dd>
        {% if spiel.spieltag %}<dt>Spieltag</dt><dd>{{ spiel.spieltag }}</dd>{% endif %}
      </dl>
    </div>

    {% if daten.letztes_spiel %}
      {% set letztes = daten.letztes_spiel %}
      <p class="unterzeile">Letztes Spiel</p>
      <div class="spielkarte">
        <div class="paarung">{{ letztes.paarung }} &nbsp; {{ letztes.ergebnis }}</div>
        <dl>
          <dt>Wettbewerb</dt><dd>{{ letztes.wettbewerb or '—' }}</dd>
          <dt>Datum</dt><dd>{{ letztes.datum or '—' }}</dd>
        </dl>
      </div>
    {% endif %}

    {{ m.stand(daten, ausgabe) }}
  {% else %}
    {{ m.leer("Für " ~ daten.anzeigename ~ " ist derzeit kein nächstes Spiel bekannt.") }}
  {% endif %}
{% endblock %}
