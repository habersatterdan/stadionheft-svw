{# Trennseite im Gesamtheft: das "schwarze Zwischenbild" der Mannschaft
   (Liga-Uebersicht aus dem Vorlage-Ordner) auf Rot, darunter die Mannschaft. #}
{% extends "_basis.html.j2" %}

{% block koerper %}
<div class="seite trenner zwischenbild">
  {% if bild_url %}<img src="{{ bild_url }}" alt="">{% endif %}
  <div class="beschriftung"><strong>{{ (daten.gruppe or daten.anzeigename)|upper }}</strong>
    {{ daten.untertitel }}</div>
</div>
{% endblock %}
