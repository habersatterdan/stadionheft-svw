{% extends "_inhaltsseite.html.j2" %}
{% import "_makros.html.j2" as m %}

{% block inhalt %}
  {% if liga %}<p class="unterzeile">{{ liga }}</p>{% endif %}

  {% if zeilen %}
    {{ m.torjaegertabelle(zeilen, hervorheben) }}
    {{ m.stand(daten) }}
  {% else %}
    {{ m.leer("Für " ~ (liga or daten.anzeigename)
              ~ " liegt derzeit keine Torschützenliste vor.") }}
  {% endif %}
{% endblock %}
