{% extends "_inhaltsseite.html.j2" %}
{% import "_makros.html.j2" as m %}

{% block inhalt %}
  {% if daten.liga %}<p class="unterzeile">{{ daten.liga }}</p>{% endif %}

  {% if daten.torjaeger %}
    <table class="daten">
      <thead>
        <tr>
          <th class="links">Pl.</th>
          <th class="links">Spieler</th>
          <th>Tore</th><th>Assists</th><th>Sp.</th>
        </tr>
      </thead>
      <tbody>
        {% for z in daten.torjaeger %}
        <tr class="{{ 'eigene' if z.eigene }}">
          <td class="platz">{{ z.platz }}.</td>
          <td class="links name">
            {{ z.spieler }}
            {% if z.mannschaft %}<span class="verein">{{ z.mannschaft }}</span>{% endif %}
          </td>
          <td>{{ z.tore }}</td>
          <td>{{ z.vorlagen }}</td>
          <td>{{ z.spiele }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {{ m.stand(daten, ausgabe) }}
  {% else %}
    {{ m.leer("Für " ~ daten.anzeigename ~ " liegt derzeit keine Torschützenliste vor.") }}
  {% endif %}
{% endblock %}
