{% extends "_inhaltsseite.html.j2" %}
{% import "_makros.html.j2" as m %}

{% block inhalt %}
  {% if liga %}<p class="unterzeile">{{ liga }}</p>{% endif %}

  {% if zeilen %}
    {{ m.ligatabelle(zeilen, hervorheben) }}
    {% if hervorheben %}
      <p class="legende">Hervorgehoben: {{ daten.anzeigename }} und der nächste
        Gegner {{ daten.gegner }}.</p>
    {% endif %}
    {{ m.stand(daten) }}
  {% else %}
    {{ m.leer("Für " ~ (liga or daten.anzeigename) ~ " liegt derzeit keine Tabelle vor.") }}
  {% endif %}
{% endblock %}
