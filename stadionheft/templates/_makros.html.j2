{# Wiederverwendbare Bausteine. #}

{% macro leer(text) %}
  <p class="leer-hinweis">{{ text }}</p>
{% endmacro %}


{# Der Stand der Daten. Steht auf jeder Datenseite -- ohne ihn laesst sich im
   Nachhinein nicht mehr sagen, welchem Spieltag ein Blatt entspricht. #}
{# Keine Fusszeile mehr unter den Tabellen ("Stand ... Quelle ...") --
   nur noch, wenn etwas nicht stimmt: veraltete Zahlen oder Beispieldaten
   duerfen nicht unbemerkt in den Druck gehen. #}
{% macro stand(daten) %}
  {%- if daten.veraltet %}
  <p class="stand stand-alt">
    <strong>Achtung – möglicherweise veraltet.</strong>
    FuPa war nicht erreichbar, verwendet wurde der Stand vom
    {{ daten.abgerufen_lesbar or 'letzten erfolgreichen Abruf' }}.
  </p>
  {%- elif daten.quelle == 'demo' %}
  <p class="stand"><strong>Beispieldaten</strong> – diese Zahlen sind nicht echt.</p>
  {%- endif %}
{% endmacro %}


{# Formkurve: die letzten Spiele als Kette von S/U/N.
   Aelteste links, juengstes rechts -- so wird eine Formkurve gelesen. #}
{% macro formkurve(eintraege) %}
  {% if eintraege %}
    <span class="form">
      {% for e in eintraege %}
        <span class="form-zeichen form-{{ e.ausgang|lower }}"
              title="{{ e.beschriftung }}">{{ e.ausgang }}</span>
      {% endfor %}
    </span>
  {% else %}
    <span class="form-leer">noch kein Spiel</span>
  {% endif %}
{% endmacro %}


{# Liga-Tabelle. ``hervorheben`` ist eine Liste von Vereinsnamen, die
   markiert werden -- die eigene Mannschaft und der naechste Gegner. #}
{% macro ligatabelle(zeilen, hervorheben) %}
  <table class="daten">
    <thead>
      <tr>
        <th class="links">Pl.</th>
        <th class="links">Team</th>
        <th>Sp.</th><th>S-U-N</th><th>Tore</th><th>Diff.</th><th>Pkt.</th>
      </tr>
    </thead>
    <tbody>
      {% for z in zeilen %}
      {% set markiert = z.eigene or (z.mannschaft in hervorheben) %}
      <tr class="{{ 'eigene' if z.eigene }}{{ ' gegner' if markiert and not z.eigene }}">
        <td class="platz">{{ z.platz }}.</td>
        <td class="links name">
          {{ z.mannschaft }}{% if z.zusatz %} <span class="verein">{{ z.zusatz }}</span>{% endif %}
        </td>
        <td>{{ z.spiele }}</td>
        <td>{{ z.bilanz }}</td>
        <td>{{ z.torverhaeltnis }}</td>
        <td>{{ '%+d'|format(z.differenz) if z.differenz else 0 }}</td>
        <td>{{ z.punkte }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}


{% macro torjaegertabelle(zeilen, hervorheben) %}
  <table class="daten mit-bild">
    <thead>
      <tr>
        <th class="links">Pl.</th>
        <th></th>
        <th class="links">Spieler</th>
        <th class="links">Verein</th>
        <th>Tore</th><th>Assists</th><th>Sp.</th>
      </tr>
    </thead>
    <tbody>
      {% for z in zeilen %}
      {% set markiert = z.eigene or (z.mannschaft in hervorheben) %}
      <tr class="{{ 'eigene' if z.eigene }}{{ ' gegner' if markiert and not z.eigene }}">
        <td class="platz">{{ z.platz }}.</td>
        <td class="bild">{% if z.bild.startswith('data:image/') %}<img src="{{ z.bild }}" alt="">{% endif %}</td>
        <td class="links name">{{ z.spieler }}</td>
        <td class="links vereinsspalte">{{ z.mannschaft }}</td>
        <td>{{ z.tore }}</td>
        <td>{{ z.vorlagen }}</td>
        <td>{{ z.spiele }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}


{# Tabelle der Spielerstatistik - wird fuer die eigene Mannschaft und
   fuer den Gegner identisch verwendet. #}
{% macro spielertabelle(zeilen) %}
  <table class="daten">
    <thead>
      <tr>
        <th class="links">Pl.</th>
        <th class="links">Spieler</th>
        <th>Spiele</th><th>Tore</th><th>Assists</th><th>11m</th>
        <th>Gelb</th><th>G/R</th><th>Rot</th>
        <th>Ein.</th><th>Aus.</th><th>Min.</th>
      </tr>
    </thead>
    <tbody>
      {% for z in zeilen %}
      <tr>
        <td class="platz">{{ z.platz }}.</td>
        <td class="links name">{{ z.spieler }}</td>
        <td>{{ z.spiele }}</td>
        <td>{{ z.tore }}</td>
        <td>{{ z.vorlagen }}</td>
        <td>{{ z.elfmeter }}</td>
        <td>{{ z.gelb }}</td>
        <td>{{ z.gelb_rot }}</td>
        <td>{{ z.rot }}</td>
        <td>{{ z.eingewechselt }}</td>
        <td>{{ z.ausgewechselt }}</td>
        <td>{{ z.minuten }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}
